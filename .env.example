# Copy to .env and fill in. NEVER commit .env.
# --- Facebook ---
FB_PAGE_ID=1287210124466263
FB_PAGE_TOKEN=your-never-expiring-page-token-here
GRAPH_VERSION=v23.0

# --- Behavior ---
# DRY_RUN=true          # force no-post mode (default is auto-dry-run if token missing)
TIMEZONE=America/New_York

# --- Alerts (optional) — get emailed when publishing is blocked ---
# Without these the bot still logs a loud banner + writes state/alerts.json; fill
# them in to also get a push email. Gmail: use an App Password, not your login.
# ALERT_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=you@gmail.com        # optional; defaults to SMTP_USER
# ALERT_RENOTIFY_HOURS=12        # re-alert cadence while a block persists

# --- Alert thresholds (optional overrides; see config.py for defaults) ---
# WAVE_NOTABLE_FT=3.0
# WAVE_BIG_FT=5.0
# WIND_BREEZY_MPH=20.0
# WIND_STRONG_MPH=30.0
# ALGAE_WATCH_RFU=1.0
# MAX_DATA_AGE_MIN=180
# ALERT_COOLDOWN_HOURS=6
